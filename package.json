{
    "name": "personal-website",
    "version": "4.3.0",
    "description": "My Personal Website",
    "scripts": {
        "clean": "rm -rf coverage dist",
        "check-format": "prettier --check \"api/**/*.ts*\" \"site/**/*.ts*\" \"tst/**/*.ts*\"",
        "format": "prettier --write \"api/**/*.ts*\" \"site/**/*.ts*\" \"tst/**/*.ts*\"",
        "types": "tsc --noEmit",
        "lint": "eslint",
        "start": "NODE_ENV=development vite",
        "start-email": "NODE_ENV=development email dev --dir site/emails/templates --port 4000",
        "create-jwt-keys": "ts-node scripts/createJWTKeys.ts",
        "build-website": "npm run types && vite build",
        "build-cdk": "npm run types && ts-node esbuild.mts",
        "bootstrap": "cdk bootstrap",
        "deploy": "cdk deploy --require-approval=never --all",
        "register-passkey": "ts-node scripts/registerPasskey.ts",
        "test": "vitest run --silent",
        "test-smoke": "playwright test"
    },
    "author": "Max Rosoff",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.914.0",
        "@aws-sdk/client-s3": "^3.914.0",
        "@aws-sdk/client-ssm": "^3.953.0",
        "@aws-sdk/credential-providers": "^3.915.0",
        "@aws-sdk/lib-dynamodb": "^3.914.0",
        "@aws-sdk/lib-storage": "^3.914.0",
        "@aws-sdk/s3-request-presigner": "^3.931.0",
        "@cf-wasm/og": "^0.5.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.5.0",
        "@mui/lab": "^9.0.0-beta.10",
        "@mui/material": "^9.5.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.3.1",
        "@simplewebauthn/browser": "^14.0.0",
        "@simplewebauthn/server": "^14.1.0",
        "@stripe/react-stripe-js": "^7.1.0",
        "@stripe/stripe-js": "^10.3.0",
        "aws-cdk-lib": "^2.220.0",
        "axios": "^1.12.2",
        "constructs": "^10.4.2",
        "email-validator": "^2.0.4",
        "fast-png": "^8.0.0",
        "get-options": "^1.2.0",
        "heic-decode": "^2.1.0",
        "jpeg-js": "^0.4.4",
        "jsonwebtoken": "^9.0.3",
        "jwt-decode": "^4.0.0",
        "luxon": "^3.7.2",
        "node-jose": "^2.2.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-easy-crop": "^6.2.3",
        "react-router-dom": "^7.9.4",
        "resend": "^6.4.2",
        "stripe": "^23.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.6.0",
        "@playwright/test": "^1.65.1",
        "@react-email/preview-server": "^5.2.11",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.12",
        "@tsconfig/vite-react": "^8.0.6",
        "@types/aws-lambda": "^8.10.156",
        "@types/heic-decode": "^2.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/luxon": "^3.7.1",
        "@types/node": "^22.20.5",
        "@types/node-jose": "^1.1.13",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/eslint-plugin": "^1.6.28",
        "@vitest/expect": "5.1.0",
        "aws-cdk": "^2.1031.0",
        "aws-sdk-client-mock": "^4.1.0",
        "aws-sdk-client-mock-jest": "^4.1.0",
        "chalk": "^6.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "jiti": "2.7.0",
        "jsdom": "^29.1.1",
        "prettier": "3.10.1",
        "react-email": "^6.11.15",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "8.73.0",
        "vite": "^8.3.8",
        "vitest": "5.1.0"
    }
}
