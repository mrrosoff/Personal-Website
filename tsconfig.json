{
    "compilerOptions": {
        "lib": ["DOM", "ESNext"],
        "types": ["node", "vite/client"],
        "resolveJsonModule": true,
        "erasableSyntaxOnly": false
    },
    "ts-node": {
        "transpileOnly": true,
        "compilerOptions": {
            "module": "NodeNext",
            "moduleResolution": "NodeNext",
            "sourceMap": true
        }
    },
    "exclude": ["vite.config.mts"],
    "extends": "@tsconfig/vite-react/tsconfig.json",
    "$schema": "https://json.schemastore.org/tsconfig"
}
